<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationId>com.example.skiabgrepro</ApplicationId>
    <ApplicationTitle>SkiaBgRepro</ApplicationTitle>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
	  <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />
	  <PackageVersion Include="SkiaSharp" Version="4.154.0" />
	  <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.0" />
  </ItemGroup>
</Project>
